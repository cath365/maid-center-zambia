rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    function protectedFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['maid', 'employer']
        && request.resource.data.status == 'active';

      allow read: if isOwner(uid) || isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && protectedFieldsUnchanged(['uid', 'role', 'status', 'email'])
        );

      allow delete: if isAdmin();
    }

    match /maids/{uid} {
      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.verificationStatus == 'pending'
          && request.resource.data.rating == 0
          && request.resource.data.profileViews == 0
        );

      allow read: if isOwner(uid)
        || isAdmin()
        || (
          signedIn()
          && userDoc().data.role == 'employer'
          && resource.data.verificationStatus == 'approved'
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && protectedFieldsUnchanged([
            'uid',
            'verificationStatus',
            'rating',
            'profileViews'
          ])
        );

      allow delete: if isAdmin();
    }

    match /employers/{uid} {
      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.verificationStatus == 'pending'
        );

      allow read: if isOwner(uid) || isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && protectedFieldsUnchanged(['uid', 'verificationStatus'])
        );

      allow delete: if isAdmin();
    }

    match /applications/{id} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.maidId == request.auth.uid
          || resource.data.employerId == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.maidId == request.auth.uid
            || resource.data.employerId == request.auth.uid
          )
          && protectedFieldsUnchanged([
            'createdBy',
            'maidId',
            'employerId'
          ])
        );

      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow create: if signedIn()
        && request.resource.data.employerId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.maidId == request.auth.uid
          || resource.data.employerId == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.maidId == request.auth.uid
            || resource.data.employerId == request.auth.uid
          )
          && protectedFieldsUnchanged(['maidId', 'employerId'])
        );

      allow delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.employerId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && protectedFieldsUnchanged(['userId']);

      allow create, delete: if isAdmin();
    }
  }
}
