rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['maid', 'employer'];
      allow read, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /maids/{uid} {
      allow create, update: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin()
        || (signedIn() && userDoc().data.role == 'employer' && resource.data.verificationStatus == 'approved');
      allow delete: if isAdmin();
    }

    match /employers/{uid} {
      allow create, update, read: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if signedIn() && (resource.data.maidId == request.auth.uid || resource.data.employerId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (resource.data.maidId == request.auth.uid || resource.data.employerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow create: if signedIn() && request.resource.data.employerId == request.auth.uid;
      allow read, update: if signedIn() && (resource.data.maidId == request.auth.uid || resource.data.employerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }
  }
}
